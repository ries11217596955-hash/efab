        "school.start",
        "agent.start"
      ]
    },
    {
      "id": "builder.run.status",
      "group": "DIAGNOSE",
      "title": "Builder managed run status",
      "kind": "OBSERVE",
      "read_only": true,
      "parallel_safe": true,
      "handler": "builtin:builder_run_status",
      "scope_note": "Read one persisted Bridge managed-run snapshot plus bounded stdout/stderr tails. Never stops, kills, retries, or starts a run.",
      "conflicts": []
    },
    {
      "id": "builder.acceptance.verify",
      "group": "DIAGNOSE",
      "title": "Builder post-checkpoint acceptance verifier",
      "kind": "PREPARE_ARTIFACT",
      "read_only": false,
      "parallel_safe": false,
      "handler": "builtin:builder_acceptance_verify",
